# CI/CD
CI_REGISTRY_HOST=
CI_REGISTRY_USER=
CI_REGISTRY_PAT=

# Database
DB_HOST=db
DB_USER=adventuremeets
DB_PASSWORD=
DB_NAME=adventuremeets
DB_PORT=5432

# API
API_PORT=8000                           # only used by docker-compose locally
API_BASEURL=http://localhost:8000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback/google
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5173/oauth/callback/facebook
FACEBOOK_GRAPH_VERSION=v20.0

# Web
WEB_PORT=5173                           # Only used by docker-compose locally
FRONTEND_URL=http://localhost:5173
VITE_API_BASEURL=http://localhost:8000
CYPRESS_BASE_URL=http://localhost:5173

# S3-compatible object storage (Garage in production)
# S3_PUBLIC_URL is the public URL prefix for this bucket, including the bucket name.
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000                            # only used by docker-compose locally
S3_REGION=
S3_FORCE_PATH_STYLE=true
S3_BUCKET=meet-images
S3_PUBLIC_URL=http://localhost:9000/meet-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Catpcha
RECAPTCHA_SECRET=
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTHCA_DISABLE=

# Worker
SCHEDULER_INTERVAL_SECONDS=10
RESPONSE_REMINDER_INTERVAL_SECONDS=86400
WORKER_API_KEY=

# Mail
MAIL_SMTP_HOST=mail
MAIL_DOMAIN=localhost
MAIL_SMTP_PORT=25
MAIL_SMTP_SECURE=false
MAIL_DEFAULT_FROM=noreply@localhost
MAIL_SMTP_HELO=localhost
MAILHOOK_URL=
DKIM_PRIVATE_KEY_BASE64=
DKIM_SELECTOR=mail

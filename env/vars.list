# Non-secret environment variables that should be appended to the generated .env file.
# Can be set either via CI/CD in GitHub or in local env/ files.

CI_REGISTRY_HOST
CI_REGISTRY_USER
MAIL_DOMAIN
MAIL_SMTP_HELO
MAIL_DEFAULT_FROM
DB_HOST
S3_ENDPOINT
S3_REGION
S3_FORCE_PATH_STYLE
S3_BUCKET
S3_PUBLIC_URL
